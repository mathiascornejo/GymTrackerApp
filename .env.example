# Copy to .env.local. Publishable values only; never put a service-role key or the VAPID private key in the client.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public half of the VAPID key pair (see docs/setup-supabase.md). Without it, background notifications stay off.
VITE_VAPID_PUBLIC_KEY=
# Set to "true" only after custom SMTP is configured and the Magic link email template contains {{ .Token }}.
VITE_EMAIL_CODE_SIGNIN=
